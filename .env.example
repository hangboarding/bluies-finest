# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave empty to run in local demo mode (data stays in this browser).
VITE_SUPABASE_URL=
# The "publishable" key (sb_publishable_...). Never the secret key.
VITE_SUPABASE_ANON_KEY=
# Optional: the PUBLIC VAPID key for phone push notifications (see docs/PUSH.md).
# Never put the private key here. Leave empty to hide the notifications option.
VITE_VAPID_PUBLIC_KEY=
